<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_MLSIGNUP</name>
    <author>Hekla</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.0.7</version>
    <description>PLG_SYSTEM_MLSIGNUP_XML_DESCRIPTION</description>
    <namespace path="src">MlSignup\Plugin\System\MlSignup</namespace>
    <files>
        <folder plugin="mlsignup">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <media destination="plg_system_mlsignup" folder="media">
        <folder>js</folder>
        <folder>css</folder>
        <filename>joomla.asset.json</filename>
    </media>
    <languages>
        <language tag="de-DE">language/de-DE/plg_system_mlsignup.ini</language>
        <language tag="de-DE">language/de-DE/plg_system_mlsignup.sys.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_mlsignup.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_mlsignup.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="api_key" type="password" maxlength="4000" size="60" label="PLG_SYSTEM_MLSIGNUP_API_KEY" description="PLG_SYSTEM_MLSIGNUP_API_KEY_DESC" autocomplete="off" filter="string" />
                <field name="group_id" type="text" label="PLG_SYSTEM_MLSIGNUP_GROUP_ID" description="PLG_SYSTEM_MLSIGNUP_GROUP_ID_DESC" filter="integer" />
                <field name="privacy_url" type="text" label="PLG_SYSTEM_MLSIGNUP_PRIVACY_URL" description="PLG_SYSTEM_MLSIGNUP_PRIVACY_URL_DESC" filter="url" />
                <field name="show_name" type="radio" label="PLG_SYSTEM_MLSIGNUP_SHOW_NAME" layout="joomla.form.field.radio.switcher" default="1" filter="integer">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="show_existing" type="radio" label="PLG_SYSTEM_MLSIGNUP_SHOW_EXISTING" description="PLG_SYSTEM_MLSIGNUP_SHOW_EXISTING_DESC" layout="joomla.form.field.radio.switcher" default="0" filter="integer">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="rate_limit" type="number" label="PLG_SYSTEM_MLSIGNUP_RATE_LIMIT" description="PLG_SYSTEM_MLSIGNUP_RATE_LIMIT_DESC" default="5" min="1" max="100" filter="integer" />
            </fieldset>
        </fields>
    </config>
</extension>
